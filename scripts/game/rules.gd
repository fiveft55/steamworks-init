class_name GameRules
extends RefCounted
## Central tuning knobs. Distances are metres; time advances in fixed ticks.

const PROTOCOL := "bean-workshop/1" # Change when RPC or state formats change.
const PORT := 24567 # ENet uses UDP, not TCP.
const MAX_PLAYERS := 4 # Small sessions keep full snapshots inexpensive.
const TICK_RATE := 60 # Prediction and authority must use the same rate.
const DT := 1.0 / TICK_RATE # One simulation step in seconds.
const SNAPSHOT_EVERY := 3 # 60 / 3 = 20 snapshots per second.
const SPEED := 6.0 # Walking speed in metres per second.
const ARENA := 12.0 # Arena extends from -12 to +12 on X and Z.
const RADIUS := 0.4 # Circular player footprint for shared collision math.
const SHOT_TICKS := 12 # Five rounds per second.
const DAMAGE := 25 # Four hits defeat a full-health bean.
const RANGE := 22.0 # Maximum hitscan range.
const MAX_WALLS := 48 # Bounds snapshot size and collision work.
const PICKUP_DISTANCE := 2.2 # Clients cannot collect across the map.
const RECIPES := { # Only authority applies these costs and rewards.
	"ammo": {"cost": {"wood": 1, "metal": 1}, "item": "ammo", "amount": 12},
	"wall": {"cost": {"wood": 3}, "item": "wall", "amount": 1},
}

static func spawn(slot: int) -> Vector2:
	# Fixed, separated spawn positions also make tests reproducible.
	return [Vector2(-4, 0), Vector2(4, 0), Vector2(0, -4), Vector2(0, 4)][slot % 4]

static func cell_key(cell: Vector2i) -> String:
	return "%d,%d" % [cell.x, cell.y] # Stable keys survive RPC serialization.

static func cell_position(key: String) -> Vector2:
	var parts := key.split(",") # These keys are generated by authority.
	return Vector2(float(parts[0]), float(parts[1]))

static func finite_vector(value: Variant) -> bool:
	# Reject NaN and infinity before distance or movement calculations.
	return value is Vector2 and is_finite(value.x) and is_finite(value.y)

static func free_position(pos: Vector2, walls: Dictionary) -> bool:
	# Arena bounds, then circle-versus-axis-aligned wall boxes.
	if absf(pos.x) > ARENA - RADIUS or absf(pos.y) > ARENA - RADIUS:
		return false
	for key in walls:
		var center := cell_position(key)
		var nearest := pos.clamp(center - Vector2.ONE * 0.5, center + Vector2.ONE * 0.5)
		if pos.distance_squared_to(nearest) < RADIUS * RADIUS:
			return false
	return true

static func move(pos: Vector2, direction: Vector2, walls: Dictionary) -> Vector2:
	# Axis separation provides simple sliding. Prediction uses this exact function.
	var step := direction.limit_length(1.0) * SPEED * DT
	var next := Vector2(pos.x + step.x, pos.y)
	if free_position(next, walls):
		pos.x = next.x
	next = Vector2(pos.x, pos.y + step.y)
	if free_position(next, walls):
		pos.y = next.y
	return pos
